# SpillTrace — local configuration. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored; `.env.example` is not. Never put a real password in this file.
# services/common/spilltrace_common/config.py reads `.env` at import time and only sets
# variables that are not already in the environment, so a shell export always wins.
#
# Everything here is optional. With none of it set, the dashboard, the API and the PDF
# report all work; a dispatch writes a .eml next to the PDF instead of sending mail.

# ---------------------------------------------------------------------------
# Incident email dispatch  (POST /api/cases/<id>/dispatch)
# ---------------------------------------------------------------------------

# Optional. Leave empty and an incident report goes to whatever addresses the sender
# types into the dashboard. Setting it *narrows* that to a list of the only addresses
# mail may reach, which is worth doing on a machine whose port other people can see:
# the dispatch endpoint has no authentication of its own.
# Comma-separated. An entry beginning with @ permits a whole domain.
SPILLTRACE_ALERT_RECIPIENTS=

# Force dry run even when SMTP is configured. Writes .eml beside the PDF, sends nothing.
# Dry run is already the default whenever SPILLTRACE_SMTP_HOST is empty.
SPILLTRACE_EMAIL_DRY_RUN=1

# SMTP. For Gmail use an App Password, not the account password, and keep port 587.
SPILLTRACE_SMTP_HOST=
SPILLTRACE_SMTP_PORT=587
SPILLTRACE_SMTP_USERNAME=
SPILLTRACE_SMTP_PASSWORD=
SPILLTRACE_SMTP_STARTTLS=1
SPILLTRACE_SMTP_SSL=0
SPILLTRACE_SMTP_TIMEOUT=20

# The From address. Defaults to SPILLTRACE_SMTP_USERNAME when omitted.
SPILLTRACE_EMAIL_FROM=
